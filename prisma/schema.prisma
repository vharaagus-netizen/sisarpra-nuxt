datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            BigInt    @id @default(autoincrement())
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  role          String    @default("siswa") @db.VarChar(50) // admin, petugas, guru, siswa
  nomor_induk   String?   @db.VarChar(100)
  no_telepon    String?   @db.VarChar(50)
  kelas_jurusan String?   @db.VarChar(100)
  remember_token String?  @db.VarChar(100)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  room_reservations          RoomReservation[] @relation("UserRoomReservations")
  approved_room_reservations RoomReservation[] @relation("ApprovedRoomReservations")
  checked_room_reservations  RoomReservation[] @relation("CheckedRoomReservations")
  item_loans                 ItemLoan[]        @relation("UserItemLoans")
  approved_item_loans        ItemLoan[]        @relation("ApprovedItemLoans")
  procurement_requests       ProcurementRequest[] @relation("UserProcurements")
  reviewed_procurements      ProcurementRequest[] @relation("ReviewedProcurements")
  lockers                    Locker[]
  lab_usage_logs             LabUsageLog[]        @relation("UserLabUsageLogs")
  lab_maintenance_logs       LabMaintenanceLog[]  @relation("UserLabMaintenanceLogs")
  damage_reports             DamageReport[]       @relation("UserDamageReports")
  technician_damage_reports  DamageReport[]       @relation("TechnicianDamageReports")
  damage_action_logs         DamageActionLog[]    @relation("UserDamageActionLogs")
  book_handovers             BookHandover[]       @relation("UserBookHandovers")
  created_disposals          DisposalRecord[]     @relation("UserCreatedDisposals")
  approved_disposals         DisposalRecord[]     @relation("UserApprovedDisposals")

  @@map("users")
}

model Category {
  id            BigInt    @id @default(autoincrement())
  nama_kategori String    @db.VarChar(255)
  deskripsi     String?   @db.Text
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  items         Item[]

  @@map("categories")
}

model Room {
  id         BigInt    @id @default(autoincrement())
  kode_ruang String    @unique @db.VarChar(100)
  nama_ruang String    @db.VarChar(255)
  kapasitas  Int       @default(0)
  lokasi     String?   @db.VarChar(255)
  fasilitas  String?   @db.Text
  status     String    @default("tersedia") @db.VarChar(50) // tersedia, perbaikan, tidak_tersedia
  foto       String?   @db.VarChar(255)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  reservations RoomReservation[]
  lab_items    LabItem[]
  damage_reports DamageReport[]

  @@map("rooms")
}

model Item {
  id                 BigInt    @id @default(autoincrement())
  category_id        BigInt
  kode_barang        String    @unique @db.VarChar(100)
  nama_barang        String    @db.VarChar(255)
  merk               String?   @db.VarChar(255)
  spesifikasi        String?   @db.Text
  total_stok         Int       @default(1)
  stok_tersedia      Int       @default(1)
  kondisi            String    @default("baik") @db.VarChar(50) // baik, rusak_ringan, rusak_berat
  lokasi_penyimpanan String?   @db.VarChar(255)
  foto               String?   @db.VarChar(255)
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt

  category       Category         @relation(fields: [category_id], references: [id], onDelete: Cascade)
  loan_details   ItemLoanDetail[]
  damage_reports DamageReport[]
  disposal_items DisposalItem[]

  @@index([category_id])
  @@map("items")
}

model RoomReservation {
  id                   BigInt    @id @default(autoincrement())
  nomor_peminjaman     String    @unique @db.VarChar(100)
  user_id              BigInt
  room_id              BigInt
  tanggal_pinjam       DateTime  @db.Date
  jam_mulai            DateTime  @db.Time(0)
  jam_selesai          DateTime  @db.Time(0)
  tujuan_kegiatan      String    @db.Text
  status               String    @default("pending") @db.VarChar(50) // pending, disetujui, ditolak, selesai, batal
  catatan_petugas      String?   @db.Text
  approved_by          BigInt?
  kondisi_kebersihan   String?   @default("bersih") @db.VarChar(50)
  kondisi_fasilitas    String?   @default("baik") @db.VarChar(50)
  catatan_pengembalian String?   @db.Text
  checked_at           DateTime?
  checked_by           BigInt?
  created_at           DateTime? @default(now())
  updated_at           DateTime? @updatedAt

  user     User  @relation("UserRoomReservations", fields: [user_id], references: [id], onDelete: Cascade)
  room     Room  @relation(fields: [room_id], references: [id], onDelete: Cascade)
  approver User? @relation("ApprovedRoomReservations", fields: [approved_by], references: [id], onDelete: SetNull)
  checker  User? @relation("CheckedRoomReservations", fields: [checked_by], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([room_id])
  @@index([approved_by])
  @@index([checked_by])
  @@map("room_reservations")
}

model ItemLoan {
  id                       BigInt    @id @default(autoincrement())
  nomor_peminjaman         String    @unique @db.VarChar(100)
  user_id                  BigInt
  tanggal_pinjam           DateTime  @db.Date
  tanggal_rencana_kembali  DateTime  @db.Date
  tanggal_realisasi_kembali DateTime?
  keperluan                String    @db.Text
  status                   String    @default("pending") @db.VarChar(50) // pending, disetujui, sedang_dipinjam, selesai, ditolak, batal
  approved_by              BigInt?
  catatan                  String?   @db.Text
  created_at               DateTime? @default(now())
  updated_at               DateTime? @updatedAt

  user     User             @relation("UserItemLoans", fields: [user_id], references: [id], onDelete: Cascade)
  approver User?            @relation("ApprovedItemLoans", fields: [approved_by], references: [id], onDelete: SetNull)
  details  ItemLoanDetail[]

  @@index([user_id])
  @@index([approved_by])
  @@map("item_loans")
}

model ItemLoanDetail {
  id              BigInt    @id @default(autoincrement())
  item_loan_id    BigInt
  item_id         BigInt
  jumlah          Int       @default(1)
  kondisi_sebelum String?   @default("baik") @db.VarChar(50)
  kondisi_sesudah String?   @db.VarChar(50)
  catatan_kondisi String?   @db.Text
  created_at      DateTime? @default(now())
  updated_at      DateTime? @updatedAt

  loan ItemLoan @relation(fields: [item_loan_id], references: [id], onDelete: Cascade)
  item Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_loan_id])
  @@index([item_id])
  @@map("item_loan_details")
}

model ProcurementRequest {
  id                BigInt    @id @default(autoincrement())
  nomor_pengajuan   String?   @unique @db.VarChar(100)
  jenis_pengadaan   String    @default("sarpra") @db.VarChar(50) // sarpra, lab
  user_id           BigInt
  nama_barang       String    @db.VarChar(255)
  kategori          String    @default("Umum") @db.VarChar(100)
  lab_type          String?   @db.VarChar(50) // komputer, kimia, fisika, biologi
  item_type         String?   @db.VarChar(50) // alat, bahan_habis_pakai
  jumlah            Int       @default(1)
  satuan            String    @default("unit") @db.VarChar(50)
  spesifikasi       String?   @db.Text
  estimasi_biaya    BigInt?
  urgensi           String    @default("sedang") @db.VarChar(50) // rendah, sedang, tinggi, mendesak
  alasan_kebutuhan  String    @db.Text
  lokasi_penempatan String?   @db.VarChar(255)
  link_dokumentasi  String?   @db.Text
  status            String    @default("menunggu_review") @db.VarChar(50) // menunggu_review, disetujui, dianggarkan, ditolak, terealisasi
  catatan_admin     String?   @db.Text
  reviewed_by       BigInt?
  reviewed_at       DateTime?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  user     User  @relation("UserProcurements", fields: [user_id], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewedProcurements", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([jenis_pengadaan])
  @@index([status])
  @@index([user_id])
  @@index([reviewed_by])
  @@map("procurement_requests")
}

model Locker {
  id              BigInt    @id @default(autoincrement())
  nomor_loker     String    @unique @db.VarChar(50)
  status          String    @default("tersedia") @db.VarChar(50) // tersedia, terisi, perbaikan
  user_id         BigInt?
  nama_pemilik    String?   @db.VarChar(255)
  role_pemilik    String?   @db.VarChar(50) // guru, siswa, staf, umum
  nomor_induk     String?   @db.VarChar(100)
  nomor_kontak    String?   @db.VarChar(100)
  keperluan       String?   @db.Text
  isi_loker       String?   @db.Text
  nomor_kunci     String?   @db.VarChar(100)
  lokasi          String?   @default("Koridor Utama Sarpra") @db.VarChar(255)
  tanggal_mulai   DateTime? @db.Date
  tanggal_selesai DateTime? @db.Date
  catatan         String?   @db.Text
  created_at      DateTime? @default(now())
  updated_at      DateTime? @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@map("lockers")
}

model LabItem {
  id                 BigInt    @id @default(autoincrement())
  room_id            BigInt?
  lab_type           String    @db.VarChar(50) // komputer, fisika, kimia, biologi
  item_type          String    @default("alat") @db.VarChar(50) // alat, bahan_habis_pakai, kit
  kode_item          String    @unique @db.VarChar(100)
  nama_item          String    @db.VarChar(255)
  kategori           String?   @db.VarChar(100)
  merk               String?   @db.VarChar(255)
  stok_total         Int       @default(1)
  stok_tersedia      Int       @default(1)
  stok_minimum       Int       @default(1)
  satuan             String    @default("unit") @db.VarChar(50) // unit, ml, gram, botol, kit, set, pcs
  kondisi            String    @default("baik") @db.VarChar(50) // baik, rusak_ringan, rusak_berat, habis
  lokasi_penyimpanan String?   @db.VarChar(255)
  tanggal_kadaluarsa DateTime? @db.Date
  jadwal_kalibrasi   DateTime? @db.Date
  spesifikasi_khusus String?   @db.Text
  keterangan         String?   @db.Text
  foto               String?   @db.VarChar(255)
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt

  room             Room?               @relation(fields: [room_id], references: [id], onDelete: SetNull)
  usage_logs       LabUsageLog[]
  maintenance_logs LabMaintenanceLog[]
  disposal_items   DisposalItem[]

  @@index([room_id])
  @@index([lab_type])
  @@index([item_type])
  @@map("lab_items")
}

model LabUsageLog {
  id                   BigInt    @id @default(autoincrement())
  lab_item_id          BigInt
  user_id              BigInt
  tanggal_praktikum    DateTime  @db.Date
  nama_guru            String?   @db.VarChar(255)
  kelas_jurusan        String    @db.VarChar(100)
  judul_praktikum      String    @db.VarChar(255)
  jumlah_digunakan     Int       @default(1)
  sisa_stok_setelahnya Int
  kondisi_alat_kembali String?   @default("baik") @db.VarChar(50)
  catatan              String?   @db.Text
  created_at           DateTime? @default(now())

  item LabItem @relation(fields: [lab_item_id], references: [id], onDelete: Cascade)
  user User    @relation("UserLabUsageLogs", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([lab_item_id])
  @@index([user_id])
  @@map("lab_usage_logs")
}

model LabMaintenanceLog {
  id               BigInt    @id @default(autoincrement())
  lab_item_id      BigInt
  user_id          BigInt
  tanggal_tindakan DateTime  @db.Date
  jenis_tindakan   String    @db.VarChar(100) // install_ulang, ganti_part, kalibrasi, pembersihan, perbaikan
  deskripsi        String    @db.Text
  status_akhir     String    @default("selesai") @db.VarChar(50)
  biaya            BigInt?
  created_at       DateTime? @default(now())

  item LabItem @relation(fields: [lab_item_id], references: [id], onDelete: Cascade)
  user User    @relation("UserLabMaintenanceLogs", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([lab_item_id])
  @@index([user_id])
  @@map("lab_maintenance_logs")
}

model DamageReport {
  id                   BigInt    @id @default(autoincrement())
  nomor_laporan        String    @unique @db.VarChar(100)
  pelapor_id           BigInt
  room_id              BigInt?
  item_id              BigInt?
  judul_kerusakan      String    @db.VarChar(255)
  deskripsi_kerusakan  String    @db.Text
  lokasi_keterangan    String?   @db.VarChar(255)
  kategori             String    @default("elektronik") @db.VarChar(50) // elektronik, mebeler, sanitasi, bangunan, it_lab, lainnya
  tingkat_urgensi      String    @default("sedang") @db.VarChar(50) // rendah, sedang, tinggi, mendesak
  status               String    @default("menunggu") @db.VarChar(50) // menunggu, diproses, tunggu_sparepart, selesai, ditolak
  foto_sebelum         String?   @db.Text
  foto_sesudah         String?   @db.Text
  ditugaskan_ke        BigInt?
  tindakan_perbaikan   String?   @db.Text
  estimasi_biaya       BigInt?
  realisasi_biaya      BigInt?
  tanggal_lapor        DateTime  @default(now())
  tanggal_selesai      DateTime?
  created_at           DateTime? @default(now())
  updated_at           DateTime? @updatedAt

  pelapor    User               @relation("UserDamageReports", fields: [pelapor_id], references: [id], onDelete: Cascade)
  teknisi    User?              @relation("TechnicianDamageReports", fields: [ditugaskan_ke], references: [id], onDelete: SetNull)
  room           Room?              @relation(fields: [room_id], references: [id], onDelete: SetNull)
  item           Item?              @relation(fields: [item_id], references: [id], onDelete: SetNull)
  logs           DamageActionLog[]
  disposal_items DisposalItem[]

  @@index([pelapor_id])
  @@index([room_id])
  @@index([item_id])
  @@index([ditugaskan_ke])
  @@index([status])
  @@index([tingkat_urgensi])
  @@map("damage_reports")
}

model DamageActionLog {
  id                BigInt    @id @default(autoincrement())
  damage_report_id  BigInt
  user_id           BigInt
  status_lama       String?   @db.VarChar(50)
  status_baru       String    @db.VarChar(50)
  catatan_tindakan  String    @db.Text
  created_at        DateTime? @default(now())

  report DamageReport @relation(fields: [damage_report_id], references: [id], onDelete: Cascade)
  user   User         @relation("UserDamageActionLogs", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([damage_report_id])
  @@index([user_id])
  @@map("damage_action_logs")
}

model Book {
  id              BigInt    @id @default(autoincrement())
  kode_buku       String    @unique @db.VarChar(100) // e.g. BK-PKWU-X-001
  judul           String    @db.VarChar(255)
  kelas           String    @db.VarChar(50) // X, XI, XII, Semua
  kurikulum       String    @default("Kurikulum Merdeka") @db.VarChar(100)
  mata_pelajaran  String?   @db.VarChar(100)
  penerbit        String?   @db.VarChar(255)
  tahun_terbit    Int?
  tahun_anggaran  Int?      @default(2026)
  sumber_dana     String    @default("BOS") @db.VarChar(100) // BOS, BOS Kinerja, Mandiri
  total_stok      Int       @default(1)
  stok_tersedia   Int       @default(1)
  stok_dipinjam   Int       @default(0)
  lokasi_rak      String?   @db.VarChar(255)
  kondisi         String    @default("baik") @db.VarChar(50)
  keterangan      String?   @db.Text
  foto            String?   @db.Text
  created_at      DateTime? @default(now())
  updated_at      DateTime? @updatedAt

  handover_items  BookHandoverItem[]
  disposal_items  DisposalItem[]

  @@index([kelas])
  @@index([kurikulum])
  @@index([sumber_dana])
  @@map("books")
}

model BookHandover {
  id                     BigInt    @id @default(autoincrement())
  nomor_surat            String    @unique @db.VarChar(100) // e.g. BAST/BUKU-BOS/2026/001
  judul_acara            String    @default("SERAH TERIMA BUKU AJAR BOS TAHUN ANGGARAN 2026") @db.VarChar(255)
  tahun_anggaran         Int       @default(2026)
  tanggal_serah_terima   DateTime  @db.Date
  
  // Pihak Pertama (Tim Pengadaan Buku Ajar BOS)
  pihak_pertama_nama     String    @default("Gloria Putri Ixora, S.Pd.") @db.VarChar(255)
  pihak_pertama_jabatan  String    @default("Tim Pengadaan Buku Ajar BOS") @db.VarChar(255)
  
  // Pihak Kedua (Koordinator Sarpra)
  pihak_kedua_nama       String    @default("Emanuel Suryajaya, S.Kom.") @db.VarChar(255)
  pihak_kedua_jabatan    String    @default("Koordinator Sarpra SMA Nusaputera") @db.VarChar(255)
  
  // Mengetahui (Kepala Sekolah)
  mengetahui_nama        String    @default("Nining Tri Palupi, S.Pd., M.Pd.") @db.VarChar(255)
  mengetahui_jabatan     String    @default("Kepala SMA Nusaputera") @db.VarChar(255)
  
  catatan                String?   @db.Text
  file_bast_signed       String?   @db.Text
  created_by             BigInt
  created_at             DateTime? @default(now())
  updated_at             DateTime? @updatedAt

  creator                User      @relation("UserBookHandovers", fields: [created_by], references: [id], onDelete: Cascade)
  items                  BookHandoverItem[]

  @@index([created_by])
  @@index([tahun_anggaran])
  @@map("book_handovers")
}

model BookHandoverItem {
  id           BigInt       @id @default(autoincrement())
  handover_id  BigInt
  book_id      BigInt?
  judul_buku   String       @db.VarChar(255)
  kelas        String       @db.VarChar(50)
  penerbit     String       @db.VarChar(255)
  tahun        Int
  jumlah       Int          @default(1) // Eksemplar

  handover     BookHandover @relation(fields: [handover_id], references: [id], onDelete: Cascade)
  book         Book?        @relation(fields: [book_id], references: [id], onDelete: SetNull)

  @@index([handover_id])
  @@index([book_id])
  @@map("book_handover_items")
}

model DisposalRecord {
  id                       BigInt    @id @default(autoincrement())
  nomor_surat              String    @unique @db.VarChar(100) // e.g. BAP/SARPRA/2026/0001
  judul_acara              String    @default("BERITA ACARA PEMUSNAHAN BARANG / ASET SEKOLAH") @db.VarChar(255)
  tahun_anggaran           Int       @default(2026)
  tanggal_pemusnahan       DateTime  @db.Date
  lokasi_pemusnahan        String?   @db.VarChar(255)
  metode_pemusnahan        String    @default("dihancurkan") @db.VarChar(100) // dihancurkan, dibakar, dibongkar_daur_ulang, limbah_b3, dibuang_tps, lainnya
  alasan_umum              String    @db.Text
  status                   String    @default("menunggu_persetujuan") @db.VarChar(50) // menunggu_persetujuan, disetujui, selesai, ditolak
  stok_terpotong           Boolean   @default(false)
  executed_at              DateTime?
  penanggung_jawab_nama    String    @default("Emanuel Suryajaya, S.Kom.") @db.VarChar(255)
  penanggung_jawab_jabatan String    @default("Koordinator Sarpra SMA Nusaputera") @db.VarChar(255)
  saksi_nama               String?   @db.VarChar(255)
  saksi_jabatan            String?   @db.VarChar(255)
  mengetahui_nama          String    @default("Nining Tri Palupi, S.Pd., M.Pd.") @db.VarChar(255)
  mengetahui_jabatan       String    @default("Kepala SMA Nusaputera") @db.VarChar(255)
  foto_sebelum             String?   @db.Text
  foto_pemusnahan          String?   @db.Text
  file_bast_signed         String?   @db.Text
  catatan_admin            String?   @db.Text
  created_by               BigInt
  approved_by              BigInt?
  approved_at              DateTime?
  created_at               DateTime? @default(now())
  updated_at               DateTime? @updatedAt

  creator  User           @relation("UserCreatedDisposals", fields: [created_by], references: [id], onDelete: Cascade)
  approver User?          @relation("UserApprovedDisposals", fields: [approved_by], references: [id], onDelete: SetNull)
  items    DisposalItem[]

  @@index([status])
  @@index([tahun_anggaran])
  @@index([tanggal_pemusnahan])
  @@index([created_by])
  @@index([approved_by])
  @@map("disposal_records")
}

model DisposalItem {
  id               BigInt   @id @default(autoincrement())
  disposal_id      BigInt
  sumber_barang    String   @default("sarpra") @db.VarChar(50) // sarpra, lab, buku, manual
  item_id          BigInt?
  lab_item_id      BigInt?
  book_id          BigInt?
  damage_report_id BigInt?
  kode_barang      String?  @db.VarChar(100)
  nama_barang      String   @db.VarChar(255)
  kategori_sumber  String?  @db.VarChar(150)
  jumlah           Int      @default(1)
  satuan           String   @default("unit") @db.VarChar(50)
  kondisi_akhir    String   @default("rusak_berat") @db.VarChar(100) // rusak_berat, kadaluarsa, usang, hilang_susut, lainnya
  nilai_perkiraan  BigInt?
  alasan_item      String?  @db.Text
  stok_dipotong    Boolean  @default(false)

  disposal      DisposalRecord @relation(fields: [disposal_id], references: [id], onDelete: Cascade)
  item          Item?          @relation(fields: [item_id], references: [id], onDelete: SetNull)
  lab_item      LabItem?       @relation(fields: [lab_item_id], references: [id], onDelete: SetNull)
  book          Book?          @relation(fields: [book_id], references: [id], onDelete: SetNull)
  damage_report DamageReport?  @relation(fields: [damage_report_id], references: [id], onDelete: SetNull)

  @@index([disposal_id])
  @@index([sumber_barang])
  @@index([item_id])
  @@index([lab_item_id])
  @@index([book_id])
  @@index([damage_report_id])
  @@map("disposal_items")
}




